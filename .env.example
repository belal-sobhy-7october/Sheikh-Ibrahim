# Admin Authentication
# Set a strong password for admin login
ADMIN_PASSWORD=your_strong_password_here

# Session Secret (REQUIRED)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_64_hex_char_secret_here

# Content Write Permission
# Set to 'true' to allow write operations (create/edit/delete) in production
# Default: false (read-only in production, writable in development)
CONTENT_WRITABLE=false

# Supabase (kept for reference, no longer used)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=